				+heading({
					title: 'Button - CTA (Click 2 Action)',
					desc: 'Using For render button for click action like button in form or any link style button',
				})
				.row
					.col-12.col-lg-6
						.mb-10
							h3 With Button
						.mb-10
							button.cmp-btn
								span Default button
						.mb-10
							button.cmp-btn.--primary
								span Primary button
						.mb-10 
							button.cmp-btn.--secondary
								span Secondary button
						.mb-10 
							button.cmp-btn.--outline
								span Outline Button
						.mb-10
							button.cmp-btn.--primary.--block.--icon.--icon-angle
								span Primary button
						.mb-10 
							button.cmp-btn.--secondary.--block.--icon.--icon-caret
								span Secondary button
						.mb-10 
							button.cmp-btn.--outline.--block
								span Outline Button
					.col-12.col-lg-6
						.mb-10
							h3 With Link
						.mb-10
							+link('#', 'Default button').cmp-btn
						.mb-10
							+link('#', 'Primary button').cmp-btn.--primary
						.mb-10 
							+link('#', 'Secondary button').cmp-btn.--secondary
						.mb-10 
							+link('#', 'Outline Button').cmp-btn.--outline
						.mb-10
							+link('#', 'Primary button').cmp-btn.--primary.--block.--icon.--icon-angle
						.mb-10 
							+link('#', 'Secondary button').cmp-btn.--secondary.--block.--icon.--icon-caret
						.mb-10 
							+link('#', 'Outline Button').cmp-btn.--outline.--block
		