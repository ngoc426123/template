		.cmp-section.--gray-bg
			.container
				+heading({
					title: 'Form',
					desc: 'Using when need a from submit or contact form',
				})
				.row
					.col-12.col-lg-6
						.cmp-form(data-form)
							.cmp-form__row
								.cmp-form__label
									label(for="email") Text
								.cmp-form__control
									input(type="text" name="email" id="email" placeholder="Enter email")
							.cmp-form__row
								.cmp-form__label
									label(for="password") Password
								.cmp-form__control
									input(type="password" name="password" id="password" placeholder="Enter password")
									button(type="button" data-btn-visible).cmp-form__btn-visible
							.cmp-form__row
								.cmp-form__label
									label(for="Select") Select
								.cmp-form__control
									select(name="password" id="password" value="1")
										option(value="1") option 1 
										option(value="2") option 2 
										option(value="3") option 3 
										option(value="4") option 4 
										option(value="5") option 5 
							.cmp-form__row
								.cmp-form__label
									label(for="address") Image Uploading
								.cmp-form__upload(data-upload)
									label(for="upload-id") 
										input(type="file" address="upload-id" id="upload-id" data-upload-file)
									.cmp-form__upload-placeholder(data-upload-placeholder)
										span Upload images
							.cmp-form__row
								.cmp-form__label
									label(for="email") Textarea
